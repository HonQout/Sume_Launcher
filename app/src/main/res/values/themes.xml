<resources>
    <!-- Base application theme. -->
    <style name="Base.Theme.SumeLauncher" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="preferenceTheme">@style/MyPreferenceTheme</item>
        <item name="colorOnSurfaceVariant">@color/black</item>
        <item name="android:windowBackground">@color/white</item>
    </style>

    <style name="Theme.SumeLauncher" parent="Base.Theme.SumeLauncher" />

    <style name="MyPreferenceTheme" parent="@style/PreferenceThemeOverlay">
        <item name="switchPreferenceCompatStyle">@style/MySwitchPreferenceCompat</item>
    </style>

    <style name="MySwitchPreferenceCompat" parent="Preference.SwitchPreferenceCompat.Material">
        <item name="android:widgetLayout">@layout/pref_switch_layout</item>
    </style>

    <style name="MyButtonStyle" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_transparent_border_button</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="MySwitchStyle" parent="Widget.AppCompat.CompoundButton.Switch">
        <item name="android:thumb">@drawable/custom_switch_thumb</item>
        <item name="track">@drawable/custom_switch_track</item>
        <item name="splitTrack">false</item>
        <item name="trackTint">@null</item>
        <item name="thumbTint">@null</item>
        <item name="showText">false</item>
        <item name="switchMinWidth">40dp</item>
        <item name="switchPadding">0dp</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:clickable">false</item>
        <item name="android:focusable">false</item>
    </style>

    <style name="NoAnimationDialog" parent="@android:style/Theme.Dialog">
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowEnterAnimation">@null</item>
        <item name="android:windowExitAnimation">@null</item>
    </style>
</resources>