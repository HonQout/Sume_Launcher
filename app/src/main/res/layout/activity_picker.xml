<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/activity_picker_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="0dp">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/activity_picker_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/transparent"
        app:navigationIcon="@drawable/baseline_arrow_back_24"
        app:navigationIconTint="?android:textColorPrimary"
        app:title="@string/replace_with"
        app:titleTextColor="?android:textColorPrimary" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="@dimen/drawer_horizontal_padding"
        android:paddingVertical="@dimen/drawer_vertical_padding">

        <include
            android:id="@+id/activity_picker_drawer"
            layout="@layout/drawer_root"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </FrameLayout>

</androidx.appcompat.widget.LinearLayoutCompat>